title: Stack vs Queue
caption: Stack mengambil yang terakhir masuk (LIFO); queue mengambil yang pertama masuk (FIFO).
---
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 520 210">
  <text x="120" y="22" class="nv-t nv-b" font-size="14" text-anchor="middle">Stack (LIFO)</text>
  <rect x="70" y="40" width="100" height="32" rx="7" class="nv-node" style="fill:var(--nv-blue);stroke:var(--nv-blue)"/>
  <text x="120" y="61" class="nv-on nv-b" font-size="13" text-anchor="middle">C (atas)</text>
  <rect x="70" y="78" width="100" height="32" rx="7" class="nv-node"/>
  <text x="120" y="99" class="nv-t" font-size="13" text-anchor="middle">B</text>
  <rect x="70" y="116" width="100" height="32" rx="7" class="nv-node"/>
  <text x="120" y="137" class="nv-t" font-size="13" text-anchor="middle">A</text>
  <path d="M182 56 H212" class="nv-edge" style="stroke:var(--nv-blue);stroke-width:2"/>
  <path d="M210 51 L218 56 L210 61 z" style="fill:var(--nv-blue)"/>
  <text x="224" y="60" class="nv-m" font-size="12">pop</text>
  <text x="120" y="182" class="nv-m" font-size="12" text-anchor="middle">masuk &amp; keluar di atas</text>
  <text x="400" y="22" class="nv-t nv-b" font-size="14" text-anchor="middle">Queue (FIFO)</text>
  <rect x="300" y="78" width="60" height="32" rx="7" class="nv-node" style="fill:var(--nv-blue);stroke:var(--nv-blue)"/>
  <text x="330" y="99" class="nv-on nv-b" font-size="13" text-anchor="middle">A</text>
  <rect x="370" y="78" width="60" height="32" rx="7" class="nv-node"/>
  <text x="400" y="99" class="nv-t" font-size="13" text-anchor="middle">B</text>
  <rect x="440" y="78" width="60" height="32" rx="7" class="nv-node"/>
  <text x="470" y="99" class="nv-t" font-size="13" text-anchor="middle">C</text>
  <text x="330" y="136" class="nv-m" font-size="12" text-anchor="middle">← keluar</text>
  <text x="470" y="136" class="nv-m" font-size="12" text-anchor="middle">masuk ←</text>
  <text x="400" y="182" class="nv-m" font-size="12" text-anchor="middle">masuk di belakang, keluar di depan</text>
</svg>
