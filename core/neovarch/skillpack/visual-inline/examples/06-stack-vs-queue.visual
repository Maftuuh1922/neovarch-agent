title: Stack vs Queue
caption: Stack mengambil yang terakhir masuk (LIFO); queue mengambil yang pertama masuk (FIFO).
---
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 360 214">
  <text x="78" y="20" class="nv-t nv-b" font-size="14" text-anchor="middle">Stack (LIFO)</text>
  <rect x="28" y="38" width="100" height="32" rx="7" class="nv-node" style="fill:var(--nv-blue);stroke:var(--nv-blue)"/>
  <text x="78" y="59" class="nv-on nv-b" font-size="13" text-anchor="middle">C (atas)</text>
  <rect x="28" y="76" width="100" height="32" rx="7" class="nv-node"/>
  <text x="78" y="97" class="nv-t" font-size="13" text-anchor="middle">B</text>
  <rect x="28" y="114" width="100" height="32" rx="7" class="nv-node"/>
  <text x="78" y="135" class="nv-t" font-size="13" text-anchor="middle">A</text>
  <path d="M134 54 H150" class="nv-edge" style="stroke:var(--nv-blue);stroke-width:2"/>
  <path d="M148 49 L156 54 L148 59 z" style="fill:var(--nv-blue)"/>
  <text x="78" y="172" class="nv-m" font-size="12" text-anchor="middle">pop: ambil dari atas</text>
  <text x="78" y="190" class="nv-m" font-size="12" text-anchor="middle">masuk &amp; keluar di atas</text>
  <text x="272" y="20" class="nv-t nv-b" font-size="14" text-anchor="middle">Queue (FIFO)</text>
  <rect x="190" y="76" width="50" height="32" rx="7" class="nv-node" style="fill:var(--nv-blue);stroke:var(--nv-blue)"/>
  <text x="215" y="97" class="nv-on nv-b" font-size="13" text-anchor="middle">A</text>
  <rect x="247" y="76" width="50" height="32" rx="7" class="nv-node"/>
  <text x="272" y="97" class="nv-t" font-size="13" text-anchor="middle">B</text>
  <rect x="304" y="76" width="50" height="32" rx="7" class="nv-node"/>
  <text x="329" y="97" class="nv-t" font-size="13" text-anchor="middle">C</text>
  <text x="215" y="130" class="nv-m" font-size="12" text-anchor="middle">← keluar</text>
  <text x="329" y="130" class="nv-m" font-size="12" text-anchor="middle">masuk ←</text>
  <text x="272" y="172" class="nv-m" font-size="12" text-anchor="middle">masuk di belakang,</text>
  <text x="272" y="190" class="nv-m" font-size="12" text-anchor="middle">keluar di depan</text>
</svg>
